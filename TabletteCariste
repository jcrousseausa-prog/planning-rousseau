<!--
  ============================================================
  TABLETTE CARISTE — Liste à servir / chargement machines
  ------------------------------------------------------------
  Page servie par Apps Script (HtmlService), communique avec le
  serveur via google.script.run (pas de fetch, pas de CORS).
  Fichier à créer dans le même projet Apps Script que
  TabletteCariste_API.gs, sous le nom EXACT "TabletteCariste".

  Habillage aligné sur achats.html / erp.html (mêmes couleurs,
  même typographie, même logo) — seule la disposition reste
  pensée pour une tablette tenue en main (gros boutons tactiles,
  panneau du bas en feuille coulissante), ce que le reste de la
  suite n'a pas besoin de faire sur poste fixe.
  ============================================================
-->
<!-- charset + viewport déjà posés côté serveur par doGet() (addMetaTag) — pas de doublon ici. -->
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F4F0;--surface:#FFF;--surface2:#FAFAF8;
  --border:#E4E2DA;--border2:#C8C5BC;
  --text:#1C1B18;--text2:#6B6860;--text3:#A8A59E;
  --blue:#1A4F8A;--blue-bg:#EAF1FB;--blue-border:#AECDF5;
  --green:#1A6640;--green-bg:#E8F5EE;--green-border:#A3D9B8;
  --orange:#B85C0A;--orange-bg:#FDF3E8;--orange-border:#F5C98A;
  --red:#9B1C1C;--red-bg:#FDF0F0;--red-border:#F5ABAB;
  --purple:#5A2D8A;--purple-bg:#F2EDF9;--purple-border:#C9AEED;
  --teal:#0E6B6B;--teal-bg:#E6F5F5;--teal-border:#8DD4D4;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--text)}
body{font-family:'DM Sans',sans-serif;font-size:16px;line-height:1.45;overscroll-behavior-y:contain}

header{
  background:var(--surface);border-bottom:1px solid var(--border);
  padding:.75rem 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(0,0,0,.08);
}
.logo{font-size:16px;font-weight:600;letter-spacing:-.02em}
.logo em{color:var(--text3);font-style:normal;font-weight:400}
.header-right{display:flex;gap:10px;margin-left:auto;align-items:center;flex-wrap:wrap}
.rt-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.rt-label{font-size:12px;color:var(--green);font-weight:500}
.rt-label.err{color:var(--red)}
.icon-btn{
  border:1px solid var(--border2);background:var(--surface);color:var(--text);border-radius:10px;
  width:42px;height:42px;font-size:18px;display:grid;place-items:center;cursor:pointer;
}
.icon-btn:active{background:var(--bg)}

.app-tabs{
  background:var(--surface);border-bottom:1px solid var(--border);
  padding:0 12px;display:flex;gap:2px;overflow-x:auto;
  position:sticky;top:65px;z-index:40;box-shadow:0 1px 3px rgba(0,0,0,.06);
}
.tab{
  flex:0 0 auto;padding:13px 16px;border:none;background:none;cursor:pointer;
  font-family:inherit;font-size:14px;font-weight:500;color:var(--text2);
  border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;
}
.tab.actif{color:var(--blue);border-bottom-color:var(--blue);font-weight:600}
.tab .n{opacity:.65;font-weight:500;margin-left:4px}

main{padding:14px;padding-bottom:88px;max-width:900px;margin:0 auto}
#etat{text-align:center;color:var(--text3);padding:40px 16px;font-size:15px}

.job{
  background:var(--surface);border:1px solid var(--border);border-radius:14px;
  margin-bottom:12px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.04);
}
.job.complet{border-color:var(--green-border);background:var(--green-bg)}
.job-head{padding:12px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:7px 9px}
.job-titre{font-weight:700;font-size:15.5px;flex:1 1 220px}
.job-sous{width:100%;color:var(--text2);font-size:13px}

.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:6px;font-size:12px;font-weight:600;white-space:nowrap;gap:3px}
.badge-blue{background:var(--blue-bg);color:var(--blue);border:1px solid var(--blue-border)}
.badge-red{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}
.badge-orange{background:var(--orange-bg);color:var(--orange);border:1px solid var(--orange-border)}
.badge-purple{background:var(--purple-bg);color:var(--purple);border:1px solid var(--purple-border)}
.badge-gray{background:var(--bg);color:var(--text2);border:1px solid var(--border)}
.badge-green{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}
.job.complet .badge-progress{background:var(--green);color:#fff;border-color:var(--green)}

.lignes{border-top:1px solid var(--border)}
.ligne{
  display:flex;align-items:center;gap:12px;padding:14px;min-height:64px;
  border-bottom:1px solid var(--surface2);cursor:pointer;user-select:none;
}
.ligne:last-child{border-bottom:none}
.ligne:active{background:var(--surface2)}
.ligne.charge{background:var(--green-bg)}
.case{
  flex:0 0 auto;width:32px;height:32px;border-radius:9px;border:2px solid var(--border2);
  background:var(--surface);display:grid;place-items:center;font-size:18px;color:#fff;
}
.ligne.charge .case{background:var(--green);border-color:var(--green)}
.ligne-corps{flex:1 1 auto;min-width:0}
.ligne-titre{font-weight:700;font-size:15.5px;font-family:'DM Mono',monospace}
.ligne-titre .special{color:var(--orange);font-weight:700;font-family:'DM Sans',sans-serif}
.ligne-meta{color:var(--text3);font-size:12.5px;margin-top:2px;font-family:'DM Sans',sans-serif}
.emplacement{flex:0 0 auto;text-align:right;font-size:12px;font-weight:700;color:var(--purple);max-width:110px;font-family:'DM Mono',monospace}
.emplacement .lab{display:block;font-size:10px;color:var(--text3);font-weight:600;text-transform:uppercase;font-family:'DM Sans',sans-serif}
.emplacement.manquant{color:var(--text3)}

footer.barre{
  position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);
  padding:10px 14px;display:flex;gap:10px;align-items:center;z-index:20;
}
.btn{flex:1;border:1px solid var(--border2);border-radius:12px;padding:14px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;background:var(--surface);color:var(--text)}
.btn-primaire{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn-primaire:active{background:#153f6e}

.modal-fond{position:fixed;inset:0;background:rgba(28,27,24,.55);z-index:30;display:flex;align-items:flex-end;justify-content:center}
.modal{background:var(--surface);width:100%;max-width:640px;max-height:85vh;overflow-y:auto;border-radius:18px 18px 0 0;padding:16px}
.modal h2{margin:4px 0 12px;font-size:18px;font-weight:600}
.modal p.aide{color:var(--text3);font-size:13px;margin-top:-6px;margin-bottom:14px}
.empl-row{display:flex;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid var(--surface2)}
.empl-row .section{flex:0 0 110px;font-weight:700;font-family:'DM Mono',monospace;font-size:13.5px}
.empl-row input{flex:1;padding:10px;border-radius:8px;border:1px solid var(--border);font-size:15px;font-family:inherit;color:var(--text);background:var(--surface)}
.empl-row input:focus{outline:none;border-color:var(--blue)}
.empl-row .ok{flex:0 0 auto;width:40px;height:40px;border-radius:8px;border:1px solid var(--border2);background:var(--surface);font-size:16px}
.modal-close{display:block;margin:14px auto 4px;background:none;border:none;color:var(--text2);font-size:14px;cursor:pointer}

#toast{
  position:fixed;top:70px;left:50%;transform:translateX(-50%) translateY(-6px);z-index:40;
  background:var(--text);color:#fff;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:500;
  opacity:0;transition:all .2s;pointer-events:none;
}
#toast.visible{opacity:1;transform:translateX(-50%) translateY(0)}
</style>

<header>
  <div style="display:flex;align-items:center;gap:12px">
    <img src="data:image/png;base64," style="height:36px;width:auto" alt="Rousseau"/>
    <div class="logo">Cariste <em>/ Chargement machines</em></div>
  </div>
  <div class="header-right">
    <div class="rt-dot" id="rt-dot"></div>
    <span class="rt-label" id="sync">chargement…</span>
    <!-- Pas de lien "← Accueil" ici : cette page est servie depuis le domaine
         script.google.com (Apps Script), pas depuis GitHub Pages comme
         index.html/erp.html/achats.html — un lien relatif href="index.html"
         serait cassé (mauvaise origine). Elle est d'ailleurs pensée comme un
         écran dédié cariste, sans besoin de navigation vers l'ERP. -->
    <button class="icon-btn" id="btnEmpl" title="Emplacements">📍</button>
    <button class="icon-btn" id="btnRefresh" title="Rafraîchir">⟳</button>
  </div>
</header>

<div class="app-tabs" id="tabs"></div>

<main>
  <div id="etat">Chargement de la liste à servir…</div>
  <div id="liste"></div>
</main>

<footer class="barre">
  <button class="btn btn-primaire" id="btnRefresh2">Rafraîchir la liste</button>
</footer>

<div id="toast"></div>

<script>
  let DONNEES = { jobs: [], machinesConnues: [] };
  let ONGLET_ACTIF = "Toutes";

  function classeMachine(nom) {
    const n = (nom || "").toLowerCase();
    if (n.indexOf("robot") > -1) return "robot-drive";
    if (n.indexOf("speed") > -1) return "speed-cut";
    if (n.indexOf("sro") > -1) return "deligneuse-sro";
    if (n.indexOf("deligneuse") > -1 || n.indexOf("déligneuse") > -1) return "deligneuse-sc";
    return "autre";
  }
  // Association type de machine → badge, sur la même palette que le reste
  // de la suite (bleu/rouge/orange/violet/gris), pas de couleur ad hoc.
  const BADGE_MACHINE = {
    "robot-drive": "badge-red",
    "speed-cut": "badge-blue",
    "deligneuse-sro": "badge-orange",
    "deligneuse-sc": "badge-orange",
    "autre": "badge-gray",
  };

  function estUrgent(dateStr) {
    if (!dateStr) return true; // "pas de date" = considéré urgent, comme la mise en forme rouge du fichier source
    const d = new Date(dateStr);
    const dans3j = new Date(); dans3j.setDate(dans3j.getDate() + 3);
    return d <= dans3j;
  }

  function toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('visible');
    setTimeout(() => t.classList.remove('visible'), 1800);
  }

  function afficherTabs() {
    const machines = DONNEES.machinesConnues && DONNEES.machinesConnues.length
      ? DONNEES.machinesConnues
      : [...new Set(DONNEES.jobs.map(j => j.machine))];
    const comptes = { "Toutes": DONNEES.jobs.length };
    machines.forEach(m => comptes[m] = DONNEES.jobs.filter(j => j.machine === m).length);

    const tabs = document.getElementById('tabs');
    tabs.innerHTML = "";
    ["Toutes", ...machines].forEach(m => {
      const b = document.createElement('button');
      b.className = 'tab' + (m === ONGLET_ACTIF ? ' actif' : '');
      b.innerHTML = m + ' <span class="n">' + (comptes[m] || 0) + '</span>';
      b.onclick = () => { ONGLET_ACTIF = m; afficherTabs(); afficherListe(); };
      tabs.appendChild(b);
    });
  }

  function afficherListe() {
    const conteneur = document.getElementById('liste');
    const etat = document.getElementById('etat');
    let jobs = DONNEES.jobs.filter(j => ONGLET_ACTIF === "Toutes" || j.machine === ONGLET_ACTIF);

    if (jobs.length === 0) {
      etat.style.display = 'block';
      etat.textContent = DONNEES.jobs.length === 0
        ? "Aucun besoin bois en attente. Tout est à jour !"
        : "Aucun besoin pour cette machine.";
      conteneur.innerHTML = "";
      return;
    }
    etat.style.display = 'none';

    conteneur.innerHTML = "";
    jobs.forEach(job => {
      const complet = job.totalCharges >= job.totalBesoins;
      const div = document.createElement('div');
      div.className = 'job' + (complet ? ' complet' : '');

      const urgent = estUrgent(job.dateBesoin);
      const dateTxt = job.dateBesoin ? job.dateBesoin : "pas de date";
      const badgeMachine = BADGE_MACHINE[classeMachine(job.machine)] || 'badge-gray';

      div.innerHTML = `
        <div class="job-head">
          <span class="badge ${badgeMachine}">${job.machine}</span>
          <span class="badge ${urgent ? 'badge-red' : 'badge-gray'}">${dateTxt}</span>
          <span class="badge badge-progress ${complet ? '' : 'badge-gray'}">${job.totalCharges}/${job.totalBesoins} chargé${job.totalBesoins > 1 ? 's' : ''}</span>
          <div class="job-titre">${job.fichier}</div>
          <div class="job-sous">${[job.chantier, job.phase].filter(Boolean).join(' · ') || '—'}${job.zoneExpedition ? ' · ' + job.zoneExpedition : ''}${job.classeCoupe ? ' · classe ' + job.classeCoupe : ''}</div>
        </div>
        <div class="lignes"></div>
      `;

      const lignesWrap = div.querySelector('.lignes');
      job.besoins.forEach((b, idx) => {
        const l = document.createElement('div');
        l.className = 'ligne' + (b.charge ? ' charge' : '');
        l.innerHTML = `
          <div class="case">${b.charge ? '✓' : ''}</div>
          <div class="ligne-corps">
            <div class="ligne-titre">${b.section} — ${b.quantite} × ${b.longueur} mm${b.longueurStandard ? '' : ' <span class="special">(spécial)</span>'}</div>
            <div class="ligne-meta">Ligne ${b.ligne}</div>
          </div>
          <div class="emplacement ${b.emplacement ? '' : 'manquant'}">
            <span class="lab">Zone</span>${b.emplacement || '—'}
          </div>
        `;
        l.onclick = () => basculerCharge(job, b, l);
        lignesWrap.appendChild(l);
      });

      conteneur.appendChild(div);
    });
  }

  function basculerCharge(job, besoin, elLigne) {
    const nouvelEtat = !besoin.charge;
    const couleurAvant = besoin.couleurActuelle;
    // Optimiste : on met à jour l'affichage tout de suite
    besoin.charge = nouvelEtat;
    job.totalCharges = job.besoins.filter(x => x.charge).length;
    elLigne.classList.toggle('charge', nouvelEtat);
    elLigne.querySelector('.case').textContent = nouvelEtat ? '✓' : '';
    afficherListe(); // ré-affiche pour mettre à jour badges/complet et compteurs d'onglets
    afficherTabs();

    const surErreur = () => {
      // annule l'optimisme si l'écriture serveur échoue
      besoin.charge = !nouvelEtat;
      job.totalCharges = job.besoins.filter(x => x.charge).length;
      afficherListe(); afficherTabs();
      toast("Échec de l'enregistrement — réessayez");
    };

    if (nouvelEtat) {
      google.script.run.withSuccessHandler(() => toast('Chargé ✓')).withFailureHandler(surErreur)
        .marquerCharge(besoin.ligne, besoin.colonne);
    } else {
      google.script.run.withSuccessHandler(() => toast('Annulé')).withFailureHandler(surErreur)
        .marquerNonCharge(besoin.ligne, besoin.colonne, couleurAvant);
    }
  }

  function charger() {
    document.getElementById('sync').textContent = 'actualisation…';
    document.getElementById('sync').classList.remove('err');
    google.script.run
      .withSuccessHandler(donnees => {
        DONNEES = donnees;
        document.getElementById('sync').textContent =
          'MAJ ' + new Date(donnees.generePar).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        afficherTabs();
        afficherListe();
      })
      .withFailureHandler(err => {
        document.getElementById('etat').style.display = 'block';
        document.getElementById('etat').textContent = "Erreur de chargement : " + (err.message || err);
        document.getElementById('sync').textContent = 'erreur';
        document.getElementById('sync').classList.add('err');
      })
      .getListeAServir();
  }

  document.getElementById('btnRefresh').onclick = charger;
  document.getElementById('btnRefresh2').onclick = charger;

  /* ---------------- Panneau Emplacements ---------------- */
  document.getElementById('btnEmpl').onclick = () => {
    const fond = document.createElement('div');
    fond.className = 'modal-fond';
    fond.innerHTML = `
      <div class="modal">
        <h2>Emplacements parc</h2>
        <p class="aide">Une zone par référence bois, pour optimiser la tournée. Modifiable ici, ou directement dans l'onglet « Emplacements parc » du fichier.</p>
        <div id="emplListe">Chargement…</div>
        <button class="modal-close" id="fermerEmpl">Fermer</button>
      </div>
    `;
    document.body.appendChild(fond);
    fond.onclick = (e) => { if (e.target === fond) document.body.removeChild(fond); };
    fond.querySelector('#fermerEmpl').onclick = () => document.body.removeChild(fond);

    google.script.run.withSuccessHandler(lignes => {
      const wrap = fond.querySelector('#emplListe');
      wrap.innerHTML = "";
      lignes.forEach(l => {
        const row = document.createElement('div');
        row.className = 'empl-row';
        row.innerHTML = `
          <div class="section">${l.section}</div>
          <input type="text" value="${l.emplacement || ''}" placeholder="ex. Parc A / Allée 3" />
          <button class="ok">💾</button>
        `;
        const input = row.querySelector('input');
        row.querySelector('.ok').onclick = () => {
          google.script.run.withSuccessHandler(() => toast('Enregistré')).enregistrerEmplacement(l.section, input.value);
        };
        wrap.appendChild(row);
      });
    }).withFailureHandler(err => {
      fond.querySelector('#emplListe').textContent = "Erreur : " + (err.message || err);
    }).listerEmplacements();
  };

  charger();
  setInterval(charger, 90000); // rafraîchissement auto toutes les 90s
</script>
